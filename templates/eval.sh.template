#!/usr/bin/env bash
# 老师给定的单任务评估入口；生成结果须再经RoboTwin锁定版代码检查。
set -euo pipefail
policy_name=sem_policy
task_name="@@TASK@@"
task_config=demo_clean
ckpt_setting=none
expert_data_num="@@EXPERT_DATA_NUM@@"
seed=10000
gpu_id=0
export CUDA_VISIBLE_DEVICES="${gpu_id}"
export HYDRA_FULL_ERROR=1
cd "$(dirname "$0")/../.."  # 只有放在RoboTwin/policy/sem_policy时路径才成立
PYTHONWARNINGS=ignore::UserWarning python script/eval_policy.py \
  --config policy/${policy_name}/deploy_policy.yml --overrides \
  --task_name "${task_name}" --task_config "${task_config}" \
  --ckpt_setting "${ckpt_setting}" --expert_data_num "${expert_data_num}" \
  --seed "${seed}" --policy_name "${policy_name}"
